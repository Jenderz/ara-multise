<IfModule mod_headers.c>
    # CORS
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"

    # Seguridad
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ─────────────────────────────────────────────────────────────────────────
  # 2. SEO BOT PRE-RENDERER — Detecta bots de redes sociales (WhatsApp,
  #    Facebook, Telegram, etc.) en URLs de producto y los envía a
  #    seo-proxy.php para que reciban los Open Graph tags correctos.
  #    Los usuarios normales no son afectados por esta regla.
  # ─────────────────────────────────────────────────────────────────────────
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot-LinkExpanding|TelegramBot|LinkedInBot|Discordbot|Pinterestbot|Googlebot|bingbot|Applebot|Embedly|vkShare|outbrain) [NC]
  RewriteCond %{REQUEST_URI} ^/product/(.+)$ [NC]
  RewriteRule ^ /seo-proxy.php?slug=%1 [L,QSA]

  # 3. Excluir archivos y carpetas reales
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Redirección SPA (incluye /product/* para usuarios humanos)
  #    El script en index.html detecta /product/slug y redirige al hash route
  RewriteRule ^ index.html [L]
</IfModule>

# 5. Configuración de Caché para PWA
<IfModule mod_headers.c>
  # Service Worker, Manifest e Index: NO CACHEAR
  <FilesMatch "(sw\.js|manifest\.json|index\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Archivos estáticos: Cachear por 1 año
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# 6. Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 7. Proteger archivos sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|package\.json|\.env|\.git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
