# Permitir acceso a imágenes
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Bloquear ejecución de PHP por seguridad
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Habilitar CORS para imágenes
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
